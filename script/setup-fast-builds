#!/usr/bin/env bash

set -euo pipefail

echo "🚀 Setting up Zed for maximum build performance..."

# Check if we're on macOS
if [[ "$OSTYPE" != "darwin"* ]]; then
    echo "❌ This script is designed for macOS. Some optimizations may not work on other platforms."
    exit 1
fi

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Install Homebrew if it's not installed
if ! command_exists brew; then
    echo "📦 Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Install sccache if it's not installed
if ! command_exists sccache; then
    echo "⚡ Installing sccache for faster compilation caching..."
    brew install sccache
else
    echo "✅ sccache is already installed"
fi

# Configure sccache for optimal performance
echo "🔧 Configuring sccache..."
export SCCACHE_CACHE_SIZE="10G"
export SCCACHE_DIR="$HOME/.cache/sccache"

# Create sccache directory if it doesn't exist
mkdir -p "$HOME/.cache/sccache"

# Set up sccache configuration
cat > "$HOME/.sccache.conf" << EOF
# sccache configuration for Zed development
cache_size = "10G"
max_frame_size = "64MB"

[disk]
dir = "$HOME/.cache/sccache"
size = "10G"
EOF

# Install ninja build system for faster incremental builds
if ! command_exists ninja; then
    echo "🥷 Installing ninja build system..."
    brew install ninja
else
    echo "✅ ninja is already installed"
fi

# Set up environment variables for optimal performance
echo "🌍 Setting up environment variables..."

# Add to shell profile
SHELL_PROFILE=""
if [[ -f "$HOME/.zshrc" ]]; then
    SHELL_PROFILE="$HOME/.zshrc"
elif [[ -f "$HOME/.bash_profile" ]]; then
    SHELL_PROFILE="$HOME/.bash_profile"
elif [[ -f "$HOME/.bashrc" ]]; then
    SHELL_PROFILE="$HOME/.bashrc"
fi

if [[ -n "$SHELL_PROFILE" ]]; then
    echo "" >> "$SHELL_PROFILE"
    echo "# Zed build optimizations" >> "$SHELL_PROFILE"
    echo "export SCCACHE_CACHE_SIZE=10G" >> "$SHELL_PROFILE"
    echo "export SCCACHE_DIR=\"\$HOME/.cache/sccache\"" >> "$SHELL_PROFILE"
    echo "export CARGO_INCREMENTAL=1" >> "$SHELL_PROFILE"
    echo "Added build optimizations to $SHELL_PROFILE"
fi

# Display cache statistics
echo ""
echo "📊 sccache statistics:"
if command_exists sccache; then
    sccache --show-stats
fi

echo ""
echo "✨ Setup complete! Here's what was configured:"
echo ""
echo "🔧 Optimizations applied:"
echo "   • sccache installed and configured (10GB cache)"
echo "   • Incremental compilation enabled globally"
echo "   • Fast linker configured for macOS targets"
echo "   • Bundle profile created for rapid iteration"
echo "   • Environment variables set in your shell profile"
echo ""
echo "🚀 Usage tips:"
echo "   • Use './script/bundle-mac -b' for fast incremental bundles"
echo "   • Use './script/bundle-mac -bl' for local development"
echo "   • Check sccache stats with: sccache --show-stats"
echo "   • Clear sccache if needed with: sccache --zero-stats"
echo ""
echo "⚡ You may need to restart your terminal or run 'source $SHELL_PROFILE' to use the new environment variables."
echo ""
echo "🎉 Happy fast building!"

